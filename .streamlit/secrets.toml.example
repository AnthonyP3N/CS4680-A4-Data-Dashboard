# Copy this file to .streamlit/secrets.toml (never commit the real one).
# On Streamlit Community Cloud, paste these lines into App settings -> Secrets.
#
# Add a key for at least ONE provider. All of these have free tiers.
# Delete the "#" in front of each line you use.

# Groq (free, fast): console.groq.com/keys
# GROQ_API_KEY = "gsk_..."

# Google Gemini (free): aistudio.google.com/apikey
# GEMINI_API_KEY = "AIza..."

# OpenRouter (free models): openrouter.ai/keys
# OPENROUTER_API_KEY = "sk-or-..."

# OpenAI (paid): platform.openai.com/api-keys
# OPENAI_API_KEY = "sk-..."

# Optional: which providers to use, in order. The second one is used only when the
# first is overloaded or rate-limited. Without this line, every provider with a key
# above is used, in the order Gemini, Groq, OpenAI, OpenRouter.
# LLM_PROVIDER = "groq,gemini"

# Optional: pin a model for a provider (otherwise the app picks one and falls back automatically)
# GROQ_MODEL = "openai/gpt-oss-120b"
# GEMINI_MODEL = "gemini-2.5-flash"

# Optional: requests per minute allowed per user session
# REQUESTS_PER_MINUTE = 8

# ---------------------------------------------------------------------------
# Saved conversations (all optional)
# ---------------------------------------------------------------------------
# Folder for saved conversations and workspace data. Default: var/ inside the project.
# ASKDATA_DATA_DIR = "/path/with/a/persistent/disk"

# Who owns a workspace: "local" (one owner, for your own computer), "link" (a private
# address per browser, for a public demo) or "login" (Streamlit sign-in).
# Default: "local" on localhost, "link" anywhere else.
# ASKDATA_AUTH = "link"

# "off" stops result previews being saved with conversations (answers can be run again).
# ASKDATA_STORE_RESULTS = "on"

# Token budget shared by long-term memory, the conversation summary and recent turns in each prompt.
# ASKDATA_CONTEXT_TOKENS = 2000

# "off" hides the form where visitors can use their own API key (the app's key above is then the only one).
# ASKDATA_ALLOW_USER_KEYS = "on"

# ---------------------------------------------------------------------------
# Limits (all optional; 0 switches a question limit off)
# ---------------------------------------------------------------------------
# Most rows one answer may return, and seconds before a query is stopped.
# ASKDATA_MAX_ROWS = 1000
# ASKDATA_QUERY_TIMEOUT_S = 8

# Questions per workspace, per network address, and across everyone using the app's own key.
# ASKDATA_RATE_PER_MINUTE = 10
# ASKDATA_RATE_PER_DAY = 300
# ASKDATA_RATE_PER_CLIENT_MINUTE = 20
# ASKDATA_RATE_GLOBAL_PER_MINUTE = 60
